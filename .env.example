# Contact form delivery through Resend (https://resend.com).
# Set these in Vercel: Project Settings > Environment Variables.
RESEND_API_KEY=
# Inbox(es) that receive inquiries, comma-separated.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL="FDA Facilitator <website@yourdomain.com>"
